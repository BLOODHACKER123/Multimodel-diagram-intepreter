# Server configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# LLM provider: auto | mock | qwen
# auto selects qwen when DASHSCOPE_API_KEY is set, otherwise mock
LLM_PROVIDER=auto

# Alibaba Cloud Model Studio / DashScope
# Copy one of the base URLs below depending on your region/workspace.
DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

# Upload and behavior
MAX_UPLOAD_MB=10
MOCK_LATENCY_MS=600
FALLBACK_TO_MOCK=true
REQUEST_TIMEOUT_MS=60000
